PORT=3000
ODDS_API_KEY=your_odds_api_key_here

# Amazon Bedrock Mantle (Mistral Large 3, Kimi K2.5, DeepSeek, Qwen, etc.)
BEDROCK_API_KEY=your_bedrock_api_key_here
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_PROJECT=default
BEDROCK_MODEL=mistral.mistral-large-3-675b-instruct

# Cloudflare Workers AI (Fallback)
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
CF_MODEL=@cf/meta/llama-3.1-8b-instruct

SPORTS=basketball_nba,soccer_epl,americanfootball_nfl
REGIONS=us,uk,eu
